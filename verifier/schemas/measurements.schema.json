{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run measurements",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "unavailable_fields"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "MEASURED",
        "PARTIAL",
        "NOT_RUN"
      ]
    },
    "ttft_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "tokens_per_second": {
      "type": [
        "number",
        "null"
      ]
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "cpu_utilization": {
      "type": [
        "number",
        "null"
      ]
    },
    "ram_bytes": {
      "type": [
        "integer",
        "null"
      ]
    },
    "gpu_utilization": {
      "type": [
        "number",
        "null"
      ]
    },
    "vram_bytes": {
      "type": [
        "integer",
        "null"
      ]
    },
    "temperature_c": {
      "type": [
        "number",
        "null"
      ]
    },
    "storage_free_bytes": {
      "type": [
        "integer",
        "null"
      ]
    },
    "elapsed_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "unavailable_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}